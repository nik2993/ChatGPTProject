{
  "name": "chatgpt-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation for ChatGPT mic interaction and email notification",
  "scripts": {
    "auth": "playwright test --project=setup",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.4.5"
  }
}
